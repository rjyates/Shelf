#!/bin/sh
# Desktop presenter. Weston headless, weston-terminal, and the profile evdev devices.
PROFILE=/oseink/run/profile.json
if ! line=$(/oseink/bin/oseink-profile "$PROFILE"); then
	printf 'oseink-desktop:profile\n' >/dev/console
	exit 1
fi
printf '%s\n' "$line" >/run/oseink-profile
printf 'oseink-profile:%s\n' "$line" >/dev/console

BANNER=/oseink/share/banner
MSG=oseink-shell
[ -f "$BANNER" ] && MSG=$(cat "$BANNER")

printf '%s\n' "$MSG" >/run/oseink-shell
printf 'oseink-desktop:%s\n' "$MSG" >/dev/console
printf '\033[2J\033[Hdesktop\n' >/dev/tty0 2>/dev/null || true
printf '%s\n' desktop >/run/oseink-session

# color levels input light width height dpi
set -- $line
kind=$3
width=$5
height=$6
dpi=$7
devs=
case $kind in
	buttons|buttons_and_touch|buttons_and_stylus|buttons_and_touch_and_stylus)
		devs="$devs buttons" ;;
esac
case $kind in
	touch|touch_and_stylus|buttons_and_touch|buttons_and_touch_and_stylus)
		devs="$devs touch" ;;
esac
case $kind in
	stylus|touch_and_stylus|buttons_and_stylus|buttons_and_touch_and_stylus)
		devs="$devs stylus" ;;
esac

RUNTIME=/run/oseink-weston
mkdir -p "$RUNTIME"
chmod 700 "$RUNTIME"
export XDG_RUNTIME_DIR=$RUNTIME

weston_pid=
seatd_pid=
input_pid=
console_nodes=

stop_one() {
	pid=$1
	[ -n "$pid" ] || return 0
	kill "$pid" 2>/dev/null || true
	i=0
	while kill -0 "$pid" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -gt 5 ]; then
			kill -9 "$pid" 2>/dev/null || true
			break
		fi
		sleep 1
	done
}

# The PS/2 keyboard and mouse are the VGA console, not profile devices.
# Remember every node we unbind so the reader session can have them back.
unbind_console() {
	for drv in atkbd psmouse; do
		for node in /sys/bus/serio/drivers/$drv/serio*; do
			[ -e "$node" ] || continue
			name=${node##*/}
			printf '%s\n' "$name" >"/sys/bus/serio/drivers/$drv/unbind" 2>/dev/null || true
			case " $console_nodes " in
			*" $drv:$name "*) ;;
			*) console_nodes="$console_nodes $drv:$name" ;;
			esac
		done
	done
}

rebind_console() {
	for item in $console_nodes; do
		drv=${item%%:*}
		name=${item#*:}
		printf '%s\n' "$name" >"/sys/bus/serio/drivers/$drv/bind" 2>/dev/null || true
	done
	console_nodes=
}

stop_children() {
	stop_one "$weston_pid"
	weston_pid=
	stop_one "$input_pid"
	input_pid=
	stop_one "$seatd_pid"
	seatd_pid=
	rebind_console
	rm -f /run/oseink-desktop.status
}

trap 'stop_children; exit 0' INT TERM
trap stop_children EXIT

fail() {
	printf 'oseink-desktop:%s\n' "$1" >/dev/console
	cat /run/oseink-seatd.log /run/oseink-weston.log /run/oseink-input.log >/dev/console 2>/dev/null || true
	exit 1
}

/usr/bin/seatd >/run/oseink-seatd.log 2>&1 &
seatd_pid=$!
i=0
while [ ! -S /run/seatd.sock ]; do
	kill -0 "$seatd_pid" 2>/dev/null || fail seatd
	i=$((i + 1))
	[ "$i" -le 20 ] || fail seatd
	sleep 1
done

# seatd is already this session's seat. libseat must not look for logind.
export LIBSEAT_BACKEND=seatd

unbind_console

[ -n "$devs" ] || fail input
/oseink/bin/oseink-input /oseink/run/input "$width" "$height" "$dpi" $devs \
	>/run/oseink-input.log 2>&1 &
input_pid=$!
i=0
while true; do
	ready=1
	for dev in $devs; do
		grep -q "Name=\"oseink $dev\"" /proc/bus/input/devices || ready=0
	done
	[ "$ready" = 1 ] && break
	kill -0 "$input_pid" 2>/dev/null || fail input
	i=$((i + 1))
	[ "$i" -le 20 ] || fail input
	sleep 1
done
udevadm settle --timeout=5 2>/dev/null || true

export WESTON_LIBINPUT_LOG_PRIORITY=info
/usr/bin/weston \
	--config=/oseink/etc/weston.ini \
	--socket=wayland-0 \
	--backend=headless \
	--renderer=pixman \
	--shell=desktop \
	--idle-time=0 \
	--width="$width" \
	--height="$height" \
	>/run/oseink-weston.log 2>&1 &
weston_pid=$!

i=0
while [ ! -S "$RUNTIME/wayland-0" ]; do
	kill -0 "$weston_pid" 2>/dev/null || fail weston
	i=$((i + 1))
	[ "$i" -le 20 ] || fail weston
	sleep 1
done

i=0
while ! pidof weston-terminal >/dev/null 2>&1; do
	kill -0 "$weston_pid" 2>/dev/null || fail weston
	i=$((i + 1))
	[ "$i" -le 20 ] || fail terminal
	sleep 1
done

printf 'weston %s %s\n' "$width" "$height" >/run/oseink-desktop.status
printf 'oseink-desktop:weston %s %s\n' "$width" "$height" >/dev/console

while true; do
	sleep 1
	# A restarting desktop rebinds these on the way out. Drop them again.
	unbind_console
	kill -0 "$weston_pid" 2>/dev/null || fail weston
	kill -0 "$input_pid" 2>/dev/null || fail input
	[ "$(/oseink/etc/init.d/S60oseink-session target)" = desktop ] || exit 0
done
