#!/bin/sh
# Desktop presenter. Weston headless plus weston-terminal. No damage frame.
PROFILE=/oseink/run/profile.json
if ! line=$(/oseink/bin/oseink-profile "$PROFILE"); then
	printf 'oseink-desktop:profile\n' >/dev/console
	exit 1
fi
printf '%s\n' "$line" >/run/oseink-profile
printf 'oseink-profile:%s\n' "$line" >/dev/console

BANNER=/oseink/share/banner
MSG=oseink-shell
[ -f "$BANNER" ] && MSG=$(cat "$BANNER")

printf '%s\n' "$MSG" >/run/oseink-shell
printf 'oseink-desktop:%s\n' "$MSG" >/dev/console
printf '\033[2J\033[Hdesktop\n' >/dev/tty0 2>/dev/null || true
printf '%s\n' desktop >/run/oseink-session

# color levels input light width height dpi
set -- $line
width=$5
height=$6

RUNTIME=/run/oseink-weston
mkdir -p "$RUNTIME"
chmod 700 "$RUNTIME"
export XDG_RUNTIME_DIR=$RUNTIME

weston_pid=
seatd_pid=

stop_one() {
	pid=$1
	[ -n "$pid" ] || return 0
	kill "$pid" 2>/dev/null || true
	i=0
	while kill -0 "$pid" 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -gt 5 ]; then
			kill -9 "$pid" 2>/dev/null || true
			break
		fi
		sleep 1
	done
}

stop_children() {
	stop_one "$weston_pid"
	weston_pid=
	stop_one "$seatd_pid"
	seatd_pid=
	rm -f /run/oseink-desktop.status
}

trap 'stop_children; exit 0' INT TERM
trap stop_children EXIT

fail() {
	printf 'oseink-desktop:%s\n' "$1" >/dev/console
	cat /run/oseink-seatd.log /run/oseink-weston.log >/dev/console 2>/dev/null || true
	exit 1
}

/usr/bin/seatd >/run/oseink-seatd.log 2>&1 &
seatd_pid=$!
i=0
while [ ! -S /run/seatd.sock ]; do
	kill -0 "$seatd_pid" 2>/dev/null || fail seatd
	i=$((i + 1))
	[ "$i" -le 20 ] || fail seatd
	sleep 1
done

/usr/bin/weston \
	--config=/oseink/etc/weston.ini \
	--socket=wayland-0 \
	--backend=headless \
	--renderer=pixman \
	--shell=desktop \
	--idle-time=0 \
	--width="$width" \
	--height="$height" \
	>/run/oseink-weston.log 2>&1 &
weston_pid=$!

i=0
while [ ! -S "$RUNTIME/wayland-0" ]; do
	kill -0 "$weston_pid" 2>/dev/null || fail weston
	i=$((i + 1))
	[ "$i" -le 20 ] || fail weston
	sleep 1
done

i=0
while ! pidof weston-terminal >/dev/null 2>&1; do
	kill -0 "$weston_pid" 2>/dev/null || fail weston
	i=$((i + 1))
	[ "$i" -le 20 ] || fail terminal
	sleep 1
done

printf 'weston %s %s\n' "$width" "$height" >/run/oseink-desktop.status
printf 'oseink-desktop:weston %s %s\n' "$width" "$height" >/dev/console

while true; do
	sleep 1
	kill -0 "$weston_pid" 2>/dev/null || fail weston
	[ "$(/oseink/etc/init.d/S60oseink-session target)" = desktop ] || exit 0
done
