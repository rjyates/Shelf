#!/bin/sh
# Read a capability profile and print its fields.
# Usage: oseink-profile FILE
FILE=${1:?}
[ -f "$FILE" ] || exit 1

get() {
	sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\" ,}]*\)\"\{0,1\}.*/\1/p" "$FILE" | sed -n '1p'
}

one_of() {
	val=$1
	shift
	for ok in "$@"; do
		[ "$val" = "$ok" ] && return 0
	done
	return 1
}

is_pos() {
	case $1 in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$1" -gt 0 ]
}

color=$(get color)
levels=$(get gray_levels)
input=$(get input)
light=$(get frontlight)
width=$(get width)
height=$(get height)
dpi=$(get dpi)

one_of "$color" gray kaleido full || exit 1
one_of "$levels" 2 16 || exit 1
one_of "$input" buttons touch stylus touch_and_stylus || exit 1
one_of "$light" yes no || exit 1
is_pos "$width" || exit 1
is_pos "$height" || exit 1
is_pos "$dpi" || exit 1

printf '%s %s %s %s %s %s %s\n' "$color" "$levels" "$input" "$light" "$width" "$height" "$dpi"
