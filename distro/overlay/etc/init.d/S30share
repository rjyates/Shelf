#!/bin/sh
# Mount host distro/overlay at /oseink. Prefer virtiofs; fall back to 9p (qemux /shared).
# cache=mmap so a host save shows up without a reboot.
TAG=shared
MNT=/oseink

_share_ok() {
	kind="$1"
	printf '%s\n' "$kind" >/run/oseink-share
	printf 'oseink-share:%s\n' "$kind" >/dev/console
}

case "$1" in
	start)
		mkdir -p "$MNT"
		if mount -t virtiofs "$TAG" "$MNT" 2>/dev/null; then
			_share_ok virtiofs
		elif mount -t 9p -o trans=virtio,version=9p2000.L,cache=mmap,msize=262144 "$TAG" "$MNT" 2>/dev/null; then
			_share_ok 9p
		else
			# No host share (headless image check, or a real device). Keep booting.
			printf 'fail\n' >/run/oseink-share
			printf 'oseink-share:fail\n' >/dev/console
		fi
		;;
	stop)
		umount "$MNT" 2>/dev/null || true
		rm -f /run/oseink-share
		;;
	*)
		echo "Usage: $0 {start|stop}"
		exit 1
		;;
esac
