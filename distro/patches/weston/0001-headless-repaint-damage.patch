 static int
+oseink_damage_busy(struct headless_output *output, pixman_region32_t *damage)
+{
+	struct weston_renderer *renderer = output->base.compositor->renderer;
+	pixman_image_t *image;
+	pixman_box32_t *rects;
+	int n, i, scale, ox, oy, busy;
+	int x0, y0, x1, y1;
+	int stride;
+	struct timespec ts;
+	long now_ms;
+	static bool warned;
+
+	if (!renderer || renderer->type != WESTON_RENDERER_PIXMAN || !renderer->pixman)
+		return -1;
+	if (!output->renderbuffer)
+		return -1;
+
+	rects = pixman_region32_rectangles(damage, &n);
+	if (!rects || n <= 0)
+		return -1;
+
+	x0 = rects[0].x1;
+	y0 = rects[0].y1;
+	x1 = rects[0].x2;
+	y1 = rects[0].y2;
+	for (i = 1; i < n; i++) {
+		if (rects[i].x1 < x0)
+			x0 = rects[i].x1;
+		if (rects[i].y1 < y0)
+			y0 = rects[i].y1;
+		if (rects[i].x2 > x1)
+			x1 = rects[i].x2;
+		if (rects[i].y2 > y1)
+			y1 = rects[i].y2;
+	}
+
+	scale = output->base.current_scale > 0 ? output->base.current_scale : 1;
+	ox = (int)output->base.pos.c.x;
+	oy = (int)output->base.pos.c.y;
+	x0 = (x0 - ox) * scale;
+	y0 = (y0 - oy) * scale;
+	x1 = (x1 - ox) * scale;
+	y1 = (y1 - oy) * scale;
+
+	image = renderer->pixman->renderbuffer_get_image(output->renderbuffer);
+	if (!image || PIXMAN_FORMAT_BPP(pixman_image_get_format(image)) != 32)
+		return -1;
+	stride = pixman_image_get_stride(image);
+	if (stride < 4)
+		return -1;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	now_ms = (long)ts.tv_sec * 1000L + ts.tv_nsec / 1000000L;
+	busy = oseink_refresh_publish(&output->damage,
+				      pixman_image_get_data(image),
+				      stride / 4,
+				      x0, y0, x1 - x0, y1 - y0,
+				      now_ms,
+				      "/oseink/run");
+	if (busy < 0 && !warned) {
+		warned = true;
+		weston_log("oseink damage: no frame written\n");
+	}
+	return busy;
+}
