{
  "openapi": "3.1.0",
  "info": {
    "title": "Shelf API",
    "version": "1.0.0",
    "description": "Catalogue, manual page progress, authenticated EPUB import/download, shared reader positions, and persisted bookmarks/annotations/reader preferences."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "cookie": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Health, server version, and api_version=1"
          }
        }
      }
    },
    "/setup": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Object containing setup_required boolean"
          }
        }
      },
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "First account created"
          },
          "409": {
            "description": "Setup already complete"
          },
          "400": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/login": {
      "post": {
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object containing token, plus HttpOnly SameSite=Strict session cookie. Server sessions use a 30-day sliding idle window renewed on each authenticated request; the browser cookie Max-Age is longer so daily use never forces a fresh sign-in."
          },
          "401": {
            "description": "Incorrect credentials"
          },
          "429": {
            "description": "Server-wide sign-in limit reached"
          }
        }
      }
    },
    "/logout": {
      "post": {
        "responses": {
          "204": {
            "description": "All account sessions revoked"
          },
          "401": {
            "description": "No valid session"
          }
        }
      }
    },
    "/books": {
      "get": {
        "responses": {
          "200": {
            "description": "Owned catalogue entries, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session"
          }
        }
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "author",
                  "total_pages"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "author": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "total_pages": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Object containing new book id"
          },
          "400": {
            "description": "Invalid book details"
          },
          "401": {
            "description": "No valid session"
          }
        }
      }
    },
    "/books/{id}/finished": {
      "post": {
        "description": "Mark finished: reading_status=finished; imported percentage=1; manual pages_read=total_pages.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Marked finished"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found"
          }
        }
      }
    },
    "/books/{id}/unfinished": {
      "post": {
        "description": "Mark unfinished (not re-reading): reading_status=unfinished; clears completion progress; keeps imported position.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Marked unfinished"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found"
          }
        }
      }
    },
    "/books/{id}/rereading": {
      "post": {
        "description": "Mark re-reading: reading_status=rereading; clears completion progress; keeps imported position for later metrics.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Marked re-reading"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found"
          }
        }
      }
    },
    "/books/{id}/progress": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pages_read"
                ],
                "properties": {
                  "pages_read": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Progress saved"
          },
          "400": {
            "description": "Progress outside book page range"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not owned or not found"
          }
        }
      }
    },
    "/stats": {
      "get": {
        "responses": {
          "200": {
            "description": "Object containing integer books, pages_read (manual entries only), finished, reading, and average_progress (0..1 mean completion across started books, including EPUB percentage)"
          },
          "401": {
            "description": "No valid session"
          }
        }
      }
    },
    "/books/import": {
      "post": {
        "description": "Import raw unencrypted EPUB, PDF, or CBZ bytes without a fixed application upload-size limit. Exact-byte duplicates are account-scoped. For PDF/CBZ without a better title, optional X-Shelf-Filename supplies the catalogue title (filename stem). EPUB/CBZ archive path, entry-count, and extreme-compression checks apply. Available memory, SQLite blob capacity, and deployment proxies may limit very large requests.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Shelf-Filename",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 500
            },
            "description": "Original upload filename; used as PDF title fallback when metadata has no /Title"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/epub+zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/pdf": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/vnd.comicbook+zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Imported: {id, duplicate:false}"
          },
          "200": {
            "description": "Already imported: {id, duplicate:true}"
          },
          "400": {
            "description": "Invalid, encrypted, unsafe, unreadable, or unusually compressed archive"
          },
          "401": {
            "description": "No valid session"
          },
          "429": {
            "description": "Import concurrency limit reached"
          }
        }
      }
    },
    "/books/{id}/pages": {
      "get": {
        "description": "CBZ page count as `{ pageCount }` (Book Orbit comic reader).",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page count"
          },
          "400": {
            "description": "Book is not a CBZ"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found"
          }
        }
      }
    },
    "/books/{id}/pages/{page}": {
      "get": {
        "description": "CBZ page image bytes (0-based page index).",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "page",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Book is not a CBZ"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book or page not found"
          }
        }
      }
    },
    "/books/{id}": {
      "delete": {
        "description": "Permanently delete a catalogue book and its stored file, position, bookmarks, annotations, and reader preferences.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found"
          }
        }
      }
    },
    "/books/{id}/file": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned EPUB file: application/epub+zip. File downloads use attachment disposition."
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Not owned, missing EPUB, or missing cover"
          }
        }
      }
    },
    "/books/{id}/cover": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned EPUB cover: image/jpeg or image/png. File downloads use attachment disposition."
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Not owned, missing EPUB, or missing cover"
          }
        }
      }
    },
    "/books/{id}/location": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "percentage"
                ],
                "properties": {
                  "position": {
                    "type": "string",
                    "maxLength": 4096,
                    "pattern": "^epubcfi\\(.*\\)$"
                  },
                  "percentage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Position saved"
          },
          "400": {
            "description": "Invalid location"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "EPUB not found or not owned"
          }
        }
      }
    },
    "/books/{id}/bookmarks": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned bookmark array (camelCase Book Orbit fields)"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found or not owned"
          }
        }
      },
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Bookmark created"
          },
          "400": {
            "description": "Invalid bookmark"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found or not owned"
          }
        }
      }
    },
    "/books/{id}/bookmarks/{markId}": {
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "markId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bookmark updated"
          },
          "404": {
            "description": "Bookmark or book not found"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "markId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Bookmark deleted"
          },
          "404": {
            "description": "Bookmark not found"
          }
        }
      }
    },
    "/books/{id}/annotations": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Annotation array, or {items,page,pageSize,total} when page/readerFileId is set"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found or not owned"
          }
        }
      },
      "post": {
        "description": "Create an annotation. EPUB rows use cfi; PDF reader highlights send pdf {page,rect,rects} (EmbedPDF page coordinates) which Shelf stores and returns for sync.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Annotation created"
          },
          "400": {
            "description": "Invalid annotation"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found or not owned"
          }
        }
      }
    },
    "/books/{id}/annotations/{annotationId}": {
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "annotationId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Annotation updated"
          },
          "404": {
            "description": "Annotation or book not found"
          }
        }
      },
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "path",
            "name": "annotationId",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Annotation deleted"
          },
          "404": {
            "description": "Annotation not found"
          }
        }
      }
    },
    "/reader/preferences/{id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Per-book settings object, or null when unset"
          },
          "401": {
            "description": "No valid session"
          },
          "404": {
            "description": "Book not found or not owned"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Merged preferences object"
          }
        }
      },
      "patch": {
        "responses": {
          "200": {
            "description": "Merged preferences object"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Preferences cleared"
          }
        }
      }
    },
    "/reader/defaults": {
      "get": {
        "responses": {
          "200": {
            "description": "Account-wide reader defaults object"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Merged defaults object"
          }
        }
      },
      "patch": {
        "responses": {
          "200": {
            "description": "Merged defaults object"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Defaults cleared"
          }
        }
      }
    },
    "/reader/defaults/{group}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "group",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One defaults group object"
          }
        }
      },
      "put": {
        "responses": {
          "200": {
            "description": "Merged group object"
          }
        }
      },
      "patch": {
        "responses": {
          "200": {
            "description": "Merged group object"
          }
        }
      },
      "delete": {
        "responses": {
          "204": {
            "description": "Group removed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "shelf_session"
      }
    },
    "schemas": {
      "Credentials": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "description": "Setup requires at least twelve UTF-8 bytes. Login accepts the existing password."
          }
        }
      },
      "Book": {
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "total_pages",
          "pages_read",
          "reading_status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "total_pages": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "Null for EPUB entries; use percentage instead."
          },
          "pages_read": {
            "type": "integer",
            "minimum": 0
          },
          "reading_status": {
            "type": "string",
            "enum": [
              "open",
              "finished",
              "unfinished",
              "rereading"
            ],
            "description": "Catalogue lifecycle for stats; unfinished vs rereading are distinct reopen paths."
          },
          "format": {
            "type": "string",
            "enum": [
              "epub",
              "pdf",
              "cbz"
            ]
          },
          "percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "position": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096,
            "description": "EPUB CFI or pdfpage(N); null before reading."
          },
          "has_cover": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
